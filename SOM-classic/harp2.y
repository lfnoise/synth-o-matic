%token	IDENTIFIER FUNCNAME DECLARATOR CONSTANT VARIABLE %token  PLUSEQ MINUSEQ MULTEQ DIVEQ EXPONEQ '?' ':' BADTOKEN%left	LOGICOR LOGICAND%left	GREQ LESSEQ NOTEQ CMPEQ '>' '<'%left	'+' '-'%left	'*' '/'%left	'^'%right	UMINUS UPLUS '!'%{#include "synth.h"#include "rpnlang.h"%}%%program		:	statementlist			{ /*compile2(opEnd, -1);*/ }			;			statementlist	:	statement			|	statementlist statement			;statement	:	assignment ';'			|	funccall ';'			;			assignment	:	VARIABLE '=' expr 				{ compile2(opAssign, varsid[--varlevel]); }			|	VARIABLE PLUSEQ expr 				{					compile2(opPushVar, varsid[--varlevel]);					compile2(opAdd, -1);					compile2(opAssign, varsid[varlevel]);				}			|	VARIABLE MINUSEQ expr 				{					compile2(opPushVar, varsid[--varlevel]);					compile2(opSubtract, -1);					compile2(opAssign, varsid[varlevel]);				}			|	VARIABLE MULTEQ expr 				{					compile2(opPushVar, varsid[--varlevel]);					compile2(opMultiply, -1);					compile2(opAssign, varsid[varlevel]);				}			|	VARIABLE DIVEQ expr 				{					compile2(opPushVar, varsid[--varlevel]);					compile2(opDivide, -1);					compile2(opAssign, varsid[varlevel]);				}			|	VARIABLE EXPONEQ expr 				{					compile2(opPushVar, varsid[--varlevel]);					compile2(opExpon, -1);					compile2(opAssign, varsid[varlevel]);				}			;arglist		:	expr 				{ numargs[funclevel-1] = 1; }			|	arglist ',' expr				{ numargs[funclevel-1] ++; }			;funccall	:	FUNCNAME '(' arglist ')'				{ compile2(opFuncCall, funcid[--funclevel]); }			|	FUNCNAME '(' ')'				{					numargs[funclevel-1] = 0; 					compile2(opFuncCall, funcid[--funclevel]); 				}			;expr	:	CONSTANT			{ compile2(opPushCon, constid[--constlevel]); }		|	VARIABLE			{ compile2(opPushVar, varsid[--varlevel]); }		|	expr '+' expr		{ compile2(opAdd, -1); }		|	expr '-' expr		{ compile2(opSubtract, -1); }		|	expr '*' expr		{ compile2(opMultiply, -1); }		|	expr '/' expr		{ compile2(opDivide, -1); }		|	expr '^' expr		{ compile2(opExpon, -1); }		|	expr '>' expr		{ compile2(opGreater, -1); }		|	expr '<' expr		{ compile2(opLess, -1); }		|	expr GREQ expr		{ compile2(opGreaterEq, -1); }		|	expr LESSEQ expr	{ compile2(opLessEq, -1); }		|	expr CMPEQ expr		{ compile2(opEqual, -1); }		|	expr NOTEQ expr		{ compile2(opNotEqual, -1); }		|	expr LOGICOR expr		{ compile2(opOr, -1); }		|	expr LOGICAND expr		{ compile2(opAnd, -1); }		|	expr '?' expr ':' expr	{ compile2(opConditional, -1); }		|	'!' expr 				{ compile2(opNot, -1); }		|	'-' expr %prec UMINUS	{ compile2(opInvert, -1); }		|	'+' expr %prec UPLUS		|	'(' expr ')'		|	funccall		|	assignment			{ compile2(opPushVar, varsid[varlevel]); }		;	uhoh	:	BADTOKEN			{ YYERROR; }