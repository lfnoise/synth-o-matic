;	FILE:		A5Tools.a;	USAGE:		A5 World Interupt level routine utilities.;	PURPOSE:	To save and retrieve the A5 world ;				global variables of an application.;	AUTHOR:		????.;	DATE:		circa 1988			PROC			EXPORT	SaveAwayA5			EXPORT	OurA5			EXPORT	TheirA5			; Store the value in regester A5 into a holding place.			SaveAwayA5	LEA		A5Hold,A0			MOVE.L	A5,(A0)			RTS; Puts the current A5 val on the stack (returns the current ;		value of A5 so we can put it back when we are done ;		via TheirA5().)		; Puts the value that we saved via SaveAwayA5() back into; regester A5.OurA5		MOVE.L	A5,4(SP)			MOVE.L	A5Hold,A5			RTS; Puts the A5 value that we got from the return val of OurA5(); back back into regester A5 when we are done.TheirA5		MOVE.L	(SP)+,A0	; Pop return address.			MOVE.L	(SP)+,A5	; put A5 parameter into A5.			JMP		(A0)		; jump to return address.; Holing tank for our applications A5 value.A5Hold		DC.L	0			ENDPROC			END			